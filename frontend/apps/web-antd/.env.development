# 开发服务器端口；必须与开发后端 CLOUD_ORIGIN=http://localhost:5555 一致
VITE_PORT=5555

VITE_BASE=/

# 接口前缀（同源，经 Vite 代理转发）
VITE_GLOB_API_URL=/api/v1

# 开发代理目标；每位开发者在 .env.development.local 中覆盖
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8080

# 不使用 mock 服务
VITE_NITRO_MOCK=false

VITE_DEVTOOLS=false

VITE_INJECT_APP_LOADING=true
