[Unit]
Description=101cloud Panel
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=101cloud
Group=101cloud
WorkingDirectory=/
#EnvironmentFile=/usr/local/etc/101cloud-panel/config.env
ExecStart=/usr/local/bin/101cloud-backend serve -c /usr/local/etc/101cloud-panel/config.env

Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

StandardOutput=journal
StandardError=journal
SyslogIdentifier=101cloud-backend

[Install]
WantedBy=multi-user.target